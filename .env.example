# Copy to .env for local development. Production values live in
# /etc/planta-notify/env on the server (written by deploy/setup-planta-notify.sh).
PERENUAL_API_KEY=            # perenual.com/user/developer (optional; search degrades without it)
VAPID_PUBLIC_KEY=            # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SESSION_SECRET=change-me
SEED_EMAIL=you@example.com   # first user, created on boot
TIMEZONE=America/Los_Angeles
DB_PATH=./plants.db
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=0              # allow session cookie over plain-HTTP dev
RESEND_API_KEY=              # optional; login codes print to console without it
EMAIL_FROM=Plant Care <noreply@example.com>
